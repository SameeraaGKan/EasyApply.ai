# Shared secret — must match AGENT_SERVICE_BEARER_TOKEN on the Next.js side.
AGENT_SERVICE_BEARER_TOKEN=

# Used only to verify Supabase-issued user JWTs via Supabase's public JWKS.
# This service never calls Supabase's data APIs.
SUPABASE_PROJECT_URL=

# console.anthropic.com — resume parsing structured extraction.
ANTHROPIC_API_KEY=

# dash.voyageai.com — resume/job embeddings for matching (voyage-3-lite).
VOYAGE_API_KEY=

# Same Neon pooled connection string as web/.env.example's DATABASE_URL.
DATABASE_URL=

# browserbase.com — optional. Powers the Form-Filler agent's browser
# sessions in production. Leave both unset for local dev: the agent falls
# back to a locally-launched headless Chromium automatically.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Must exactly match web/.env.example's PROFILE_ENCRYPTION_KEY — used to
# decrypt profiles.eeo_* when filling EEO fields on real application forms.
PROFILE_ENCRYPTION_KEY=

# sentry.io — optional, error tracking.
SENTRY_DSN=
