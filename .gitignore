# web/ has its own .gitignore (generated by create-next-app) that covers
# node_modules, .next, env files, etc. — this file only needs to cover
# agent-service/ and OS/editor noise at the repo root.

# Python (agent-service/)
agent-service/.venv/
agent-service/__pycache__/
agent-service/**/__pycache__/
agent-service/.env
agent-service/.env.*.local
agent-service/*.egg-info/

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
